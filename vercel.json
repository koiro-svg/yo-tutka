{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "python3 scripts/validate_tools.py && python3 scripts/validate_practice.py && python3 scripts/check_tokens.py",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/hyppymittari",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self'"
        }
      ]
    },
    {
      "source": "/hyppymittari/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ai-opas",
      "destination": "/ai"
    },
    {
      "source": "/ai-tyokalut",
      "destination": "/ai"
    }
  ]
}
