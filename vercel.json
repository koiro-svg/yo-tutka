{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "python3 scripts/validate_tools.py && python3 scripts/validate_practice.py && python3 scripts/check_tokens.py && python3 scripts/yo_index.py",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/hyppymittari",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self'"
        }
      ]
    },
    {
      "source": "/hyppymittari/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self'"
        }
      ]
    },
    {
      "source": "/hyppymittari/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/hyppymittari"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ai-opas",
      "destination": "/ai",
      "permanent": true
    },
    {
      "source": "/ai-tyokalut",
      "destination": "/ai?tab=tyokalut",
      "permanent": true
    },
    {
      "source": "/yo",
      "destination": "/yo-tutka",
      "permanent": false
    }
  ]
}
